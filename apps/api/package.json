{
  "name": "@gastos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "db:migrate": "bun db/migrate.ts",
    "db:routines": "bun db/migrate.ts --routines-only",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.35.1",
    "better-auth": "1.4.18",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
