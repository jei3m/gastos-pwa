{
  "name": "gastos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp -C apps/web dev",
    "dev:api": "vp -C apps/api run dev",
    "build": "vp run -r build",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "vp run -r typecheck",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
